{
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"additionalContext\": \"Available dev-flow MCP tools (use these instead of ToolSearch): dev_status (~30t), dev_flow (~100t), dev_config (~50t), dev_ledger (~50t), dev_tasks (~30t), dev_coordinate (~40t), dev_handoff (~50t), dev_aggregate (~60t), dev_commit (~30t), dev_memory (~60t), dev_changes (~50t), dev_defaults (~20t), dev_version (~30t), dev_commits (~100t), dev_inbox (~50t), dev_spec (~50t), dev_branch (~30t), dev_check (~10t), dev_fix (~20t), dev_next (~15t), dev_ready (~20t). Read tool for files. Grep/Glob for search. Bash for git/shell. Never call claude CLI from Bash.\"}'",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/url-reader.sh",
            "timeout": 3,
            "statusMessage": "Detecting URLs..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/intent-router.sh",
            "timeout": 3,
            "statusMessage": "Analyzing intent..."
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/plan-scope-check.sh",
            "timeout": 5,
            "statusMessage": "Checking plan scope..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(*git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/commit-guard.sh",
            "timeout": 3,
            "statusMessage": "Validating commit flow..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start-continuity.sh",
            "timeout": 10,
            "statusMessage": "Loading project context...",
            "once": true
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/memory-sync.sh",
            "timeout": 5,
            "statusMessage": "Syncing memory...",
            "once": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-compact.sh",
            "timeout": 10,
            "statusMessage": "Backing up transcript..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "A Claude Code session is ending. FIRST: Check if an auto-pipeline is active by looking for .claude/cache/.auto-pipeline-*.done.json (done file) — if it exists and current_stage is 'done', return {\"ok\": true} immediately without further evaluation.\n\nOtherwise evaluate TWO things:\n\n1) COMPLETION: Did Claude fully address the user's original request? All changes made? Any steps skipped?\n2) SUMMARY: If the session involved meaningful work (code changes, research, planning), Claude should save a session summary.\n\nFor trivial sessions (greeting, single question, no real work), return {\"ok\": true}.\n\nIf incomplete work remains, return {\"ok\": false, \"reason\": \"Remaining: [specific steps]. Then update MEMORY.md Last Session section.\"}.\n\nIf work is complete but summary not yet saved, return {\"ok\": false, \"reason\": \"Before stopping, update MEMORY.md Last Session section (between <!-- LAST-SESSION-START --> and <!-- LAST-SESSION-END --> markers) with:\\n## Last Session\\n- Next: [what should happen next, 1 sentence]\\n- Learned: [key insight, 1 sentence]\\n<!-- AUTO-UPDATED by session-summary.sh -->\"}.",
            "timeout": 15,
            "once": true,
            "statusMessage": "Verifying completion..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-summary.sh",
            "timeout": 15,
            "statusMessage": "Saving session summary..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "implement-agent|plan-agent",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "A subagent just finished. Evaluate the output quality: 1) Does it answer the assigned task with specific, actionable information? 2) Is the output concrete (file paths, code snippets, clear recommendations) rather than vague? 3) Are there obvious errors, unsupported claims, or hallucinated file paths? If the output is acceptable, return {\"ok\": true}. If quality is poor (vague, incomplete, or contains errors), return {\"ok\": false, \"reason\": \"[what's wrong and how to ask better]\"}.",
            "timeout": 15,
            "statusMessage": "Checking subagent output..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-end.sh",
            "timeout": 10,
            "statusMessage": "Saving session state..."
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/task-checkpoint.sh",
            "timeout": 5000,
            "statusMessage": "Checkpointing task..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/scope-drift-check.sh",
            "timeout": 5,
            "async": true,
            "statusMessage": "Checking scope drift..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/validate-versions.sh",
            "timeout": 5,
            "statusMessage": "Checking version consistency..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-edit-format.sh",
            "timeout": 10,
            "async": true,
            "statusMessage": "Auto-formatting..."
          }
        ]
      },
      {
        "matcher": "Bash(git *)|Bash(gh *)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/dev-workflow.sh",
            "timeout": 10,
            "statusMessage": "Checking dev workflow..."
          }
        ]
      },
      {
        "matcher": "TeamCreate",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/track-team.sh create",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "TeamDelete",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/track-team.sh delete",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
